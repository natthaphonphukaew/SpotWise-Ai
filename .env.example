# Copy to .env.local and fill in. Never commit .env.local.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: model id (default gemini-3.8-flash). Fallback: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# Optional: "cache" = demo mode, answer only from llm-cache/ and never call the API
LLM_MODE=
