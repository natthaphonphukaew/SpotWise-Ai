{
  "name": "spotwise-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "classify:poi": "tsx scripts/classify-poi.ts",
    "eval:poi": "tsx scripts/eval-poi.ts",
    "backtest": "tsx scripts/backtest.ts",
    "test:report": "vitest run --reporter=json --outputFile=.vitest-report.json && tsx scripts/test-report.ts",
    "eval:labels": "tsx scripts/eval-labels.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "maplibre-gl": "^6.14.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
